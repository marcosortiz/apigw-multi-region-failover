#!/bin/bash
#
# Git pre-commit hook for Lambda function validation
# 
# To install this hook:
#   cp .git-hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Or use: git config core.hooksPath .git-hooks
#

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

echo -e "${YELLOW}Running pre-commit Lambda validation...${NC}"

# Get list of changed Python files
CHANGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.py$' || true)

if [ -z "$CHANGED_FILES" ]; then
    echo -e "${GREEN}No Python files changed, skipping validation${NC}"
    exit 0
fi

echo -e "${YELLOW}Changed Python files:${NC}"
echo "$CHANGED_FILES"
echo ""

# Validate Python syntax
echo -e "${YELLOW}Validating Python syntax...${NC}"
for file in $CHANGED_FILES; do
    if [ -f "$file" ]; then
        python3 -m py_compile "$file"
        if [ $? -eq 0 ]; then
            echo -e "  ${GREEN}✓ $file${NC}"
        else
            echo -e "  ${RED}✗ $file - Syntax error${NC}"
            exit 1
        fi
    fi
done

# Run unit tests if Lambda source files changed
LAMBDA_CHANGED=$(echo "$CHANGED_FILES" | grep -E '(service1|service2|external-api)/src/.*\.py' || true)

if [ -n "$LAMBDA_CHANGED" ]; then
    echo ""
    echo -e "${YELLOW}Lambda source files changed, running unit tests...${NC}"
    
    # Run simple tests (faster than pytest)
    python3 run-simple-tests.py
    
    if [ $? -eq 0 ]; then
        echo -e "${GREEN}✓ All unit tests passed${NC}"
    else
        echo -e "${RED}✗ Unit tests failed${NC}"
        echo -e "${RED}Please fix the failing tests before committing${NC}"
        exit 1
    fi
fi

echo ""
echo -e "${GREEN}✓ Pre-commit validation passed${NC}"
exit 0
